<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Hero Jumbotron Configuration"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="true">
                <items jcr:primaryType="nt:unstructured">
                    <text
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Text Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <greeting
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Greeting Text (e.g., Good afternoon)"
                                name="./greeting"
                                required="false"/>
                            <heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Main Heading (H1)"
                                name="./heading"
                                required="true"/>
                            <bodyText
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                fieldLabel="Body Text/Purpose"
                                name="./bodyText"
                                use="content.xml"
                                required="true"/>
                        </items>
                    </text>
                    <cta
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Call to Actions"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <primaryCtaFieldSet
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                                fieldLabel="Primary CTA (Video Link)">
                                <items jcr:primaryType="nt:unstructured">
                                    <primaryCtaText
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Primary CTA Button Text"
                                        name="./primaryCtaText"
                                        value="Play Video"
                                        required="true"/>
                                    <primaryCtaLink
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Primary CTA Link/Video Path"
                                        name="./primaryCtaLink"
                                        rootPath="/content"
                                        required="true"/>
                                </items>
                            </primaryCtaFieldSet>
                            <secondaryCtaFieldSet
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/fieldset"
                                fieldLabel="Secondary CTA (Get Started Link)">
                                <items jcr:primaryType="nt:unstructured">
                                    <secondaryCtaText
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Secondary CTA Button Text"
                                        name="./secondaryCtaText"
                                        value="Get Started"
                                        required="true"/>
                                    <secondaryCtaLink
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Secondary CTA Link Path"
                                        name="./secondaryCtaLink"
                                        rootPath="/content"
                                        required="true"/>
                                </items>
                            </secondaryCtaFieldSet>
                        </items>
                    </cta>
                    <image
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Visual"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <deviceImage
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                autoStart="false"
                                class="cq-droptarget"
                                fieldLabel="Device Visual Image"
                                fileNameParameter="./deviceImage/fileName"
                                fileReferenceParameter="./deviceImage/fileReference"
                                mimeTypes="[image/gif,image/jpeg,image/png,image/webp]"
                                name="./deviceImage/file"
                                uploadUrl="${sling:resourcePath}"/>
                        </items>
                    </image>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
